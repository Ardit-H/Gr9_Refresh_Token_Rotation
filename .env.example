# Keycloak image tag used by docker-compose. 26.2.5 is the version studied
# for CVE-2026-1035 (strict refresh-token rotation race condition).
KEYCLOAK_VERSION=26.2.5

# Hydra image tag and refresh-token reuse grace period (0s = strict,
# single-use rotation). Set e.g. HYDRA_GRACE_PERIOD=5s to study the same
# silent-takeover question as experiments/configs/grace.yaml, then run
# experiments/run_hydra_grace_validation.py against it.
HYDRA_VERSION=v26.2.0
HYDRA_GRACE_PERIOD=0s